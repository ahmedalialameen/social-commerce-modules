# WhatsApp Business Cloud API Configuration

# The base URL for the Meta Graph API. Defaults to https://graph.facebook.com/v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0

# Your WhatsApp Phone Number ID (found in your Meta App Dashboard under WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Your permanent or temporary Meta system user access token (with whatsapp_business_messaging permission)
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# A secret string you define to verify your webhook subscription on the Meta Dashboard
WHATSAPP_VERIFY_TOKEN=your_webhook_verification_token_here

# Default language code for your template messages. Defaults to en_US
WHATSAPP_TEMPLATE_DEFAULT_LANG=en_US
